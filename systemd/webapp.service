[Unit]
Description=Enterprise Multi-Tier Backend Application Service
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=webapp
Group=webapp
WorkingDirectory=/var/www/webapp
EnvironmentFile=/etc/webapp/webapp.env
ExecStart=/usr/bin/python3 /var/www/webapp/app.py
Restart=always
RestartSec=5s

# Required sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/www/webapp/data /var/log/webapp

# Extra hardening (lowers the exposure score; test that the app still starts)
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target